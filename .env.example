# Copy to .env.local (git-ignored) and fill in once. These are built into Inkwell so people
# just click "Sign in with Google / Microsoft". See docs/SETUP.md for how to get them.
# Desktop OAuth clients can't keep secrets, so these are identifiers rather than passwords,
# but keep them out of public repos anyway.

# Entra ID app registration (multi-tenant, public client, redirect http://localhost)
MAIN_VITE_MICROSOFT_CLIENT_ID=
# "organizations" = work/school accounts only; "common" also allows personal Microsoft accounts
MAIN_VITE_MICROSOFT_TENANT=organizations

# Google Cloud OAuth client of type "Desktop app"
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
