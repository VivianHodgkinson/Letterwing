{
  "name": "inkwell",
  "version": "0.1.0",
  "description": "Inkwell: a customisable desktop mail and calendar client",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --packages=external --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --outdir=out/test --out-extension:.js=.mjs --log-level=warning && for t in out/test/*.test.mjs; do ELECTRON_RUN_AS_NODE=1 electron $t || exit 1; done"
  },
  "author": "Vivian Hodgkinson",
  "license": "MIT",
  "productName": "Inkwell",
  "build": {
    "appId": "za.co.issuesoftware.inkwell",
    "productName": "Inkwell",
    "executableName": "inkwell",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ]
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "ical.js": "^2.2.1",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "hoodiecrow-imap": "^3.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.8"
  }
}
